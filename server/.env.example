# Local development defaults (matches docker-compose.yml).
# Copy to server/.env (Bun loads .env from the working directory).
DATABASE_URL=postgres://tahseel:tahseel@localhost:5432/tahseel
API_PORT=3000

# 32+ random bytes, base64. Generate with: openssl rand -base64 32
API_KEY_PEPPER=
SECRETS_ENCRYPTION_KEY=

# Used by tests to create throwaway databases (needs CREATEDB).
TEST_DATABASE_ADMIN_URL=postgres://tahseel:tahseel@localhost:5432/postgres
